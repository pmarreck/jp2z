# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	LICENSE = MIT License (c) 2026 Peter Marreck + OpenJPEG BSD-2 third-party notice (Einstein/Peter ruling 2026-06-30)
	NOTICE = Third-party attribution (OpenJPEG BSD-2); jp2z own license TBD pending Peter
	THIRD_PARTY/openjpeg-LICENSE.txt = OpenJPEG BSD-2 license, verbatim copy (attribution for the linked Phase-1 backend / ported algorithms)
	conformance/MUTATION_SCORECARD.md = Dated false-positive, known-corrupt, unsupported, and entropy-mutation sensitivity evidence
	conformance/PROBE_COVERAGE.md = corruption-probe results per fixture and Rsiz, survivor classification (comment, equivalent encoding, self-consistent field change, MQ cap residue, real gap), and the honest coverage summary
	conformance/SCORECARD.md = Generated conformance scorecard (by ./sweep): PASS/NEAR/FAIL/skip tally + ranked decode-gap list for Phase-2 prioritization
	conformance/probe = corruption-probe evidence per fixture: report.json, report.md, events.ndjson (per-trial offsets and validator output), run.log; seed 0x1234, 100 rounds per mode
	conformance/sweep.ndjson = Generated per-fixture sweep records (self-describing NDJSON, _meta header); committed as the deterministic regression baseline
	docs/INTERFACE_CONTRACT.md = Frozen v1 public interface (Zig surface + C ABI + finding registry) consumers pin against; Einstein-gated
	docs/T800_PROFILES.md = T.800 Rsiz table A.10 and profile restriction tables (A.45, cinema, broadcast, IMF) transcribed by Peter from the 2015 consolidated text; source for profile checks
	docs/T800_REVERSIBLE_EXPONENT_EVIDENCE.md = Summary of the reversible-exponent clause search: E-10 is informative, so an exponent/precision mismatch cannot be a proven FAIL
	docs/T800_REVERSIBLE_QUANTIZATION_VERBATIM.md = Peter's verbatim T.800 (11/2015) extracts: Annex E (E-2, E-4, E.1.2, informative E.2 with E-10), Tables A.28-A.30, Table A.11
	probe-label = Driver: builds jp2z-probe-label and labels every fixture's probe survivors into conformance/probe/<fixture>/labels.ndjson, printing the Markdown table
	src/decode/codestream.zig = J2K/JP2 walker: markers, tile-parts, packet iterator (heap per-component geometry), TileWalk; CodingParams with heap CompDesc per component (clone/deinit)
	src/decode/dwt.zig = Inverse 5/3 DWT (reversible lifting, 1D + 2D Mallat); cleanroom vs openjpeg idwt53
	src/decode/image.zig = Planar cleanroom output → public interleaved Image: canvas at finest sub-sampling, palette (pclr/cmap) application, clamp, u8/u16, colr colour space; the wrapper-free decode route
	src/decode/profiles.zig = Rsiz profile classification (Table A.10 + amendment families) and per-profile restriction checks (Table A.45, cinema, broadcast, IMF) emitting 259 profile_violation; tile-part rules consumed by walkTileParts
	src/decode/reconstruct.zig = Cleanroom reconstruct (5/3 + 9/7 + RCT/ICT + level shift) AND deepValidate strict-findings entry point (M7)
	sweep = Conformance-sweep driver: runs sweep_one over all 57 ISO 15444-4 fixtures, writes conformance/{sweep.ndjson,SCORECARD.md}; deterministic regression net
	tests/cli/validate_cli = Bash CLI test for the validate verb: verdict exit codes (0 pass/info, 2 warn, 1 fail, 64 usage, 74 I/O), --json, stdin, corrupted copy strict vs lenient, paths with spaces
	tests/mutation_matrix.zig = OpenJPEG-free strict-validation classifier over valid controls and deterministic mutation scales
	tests/unit/fixtures/conformance/balloon_eciRGB_icc.jp2 = Real-encoder must-accept control (12 tiles, 8 layers, RPCL, SEGSYM, 9/7, ICC) — guards the empty-packet extractor false-positive class
	tests/unit/fixtures/conformance/d2_colr.j2c = ISO 15444-4 class D fixture with tile-part COD overrides (progression per tile); mutation-matrix must-accept control
	tests/unit/fixtures/conformance/g3_colr.j2c = ISO 15444-4 packed-packet-header (PPM/PPT) conformance fixture; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/g4_colr.j2c = ISO 15444-4 packed-packet-header (PPM/PPT) conformance fixture; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p0_02.j2k = ISO 15444-4 fixture with COC/RGN per-component overrides; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p0_03.j2k = ISO 15444-4 fixture with COC/RGN per-component overrides; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p0_04.j2k = 9/7 lossy 3-comp+ICT+TERMALL conformance fixture (640x480, PAE<=1)
	tests/unit/fixtures/conformance/p0_06.j2k = ISO 15444-4 fixture with COC/RGN per-component overrides; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p0_09.j2k = 9/7 lossy mono conformance fixture (17x37, byte-perfect target)
	tests/unit/fixtures/conformance/p1_01.j2k = ISO 15444-4 fixture with COC/RGN per-component overrides; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p1_06.j2k = ISO 15444-4 packed-packet-header (PPM/PPT) conformance fixture; mutation-matrix must-accept control
	tests/unit/fixtures/conformance/p1_07.j2k = ISO 15444-4 fixture with COC/RGN per-component overrides; mutation-matrix must-accept control
	tests/unit/fixtures/oracles/a1_mono.t1.bin = OpenJPEG t1 oracle for a1_mono.j2c (pure-MQ, byte-perfect target) — JP2Z_DUMP_T1 dump, 34 cblk records
	tests/unit/fixtures/oracles/d1_colr.t1.bin = OpenJPEG t1 oracle for d1_colr.j2c (pure-MQ, 3-comp MCT, multi-precinct, byte-perfect) — 174 cblk records
