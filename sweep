#!/usr/bin/env bash
# ./sweep — conformance sweep over the ISO 15444-4 fixture set.
#
# Runs the pure-Zig `decodeCleanroom` against every fixture in
# $OPENJPEG_DATA/input/conformance (one isolated process per fixture, via
# tools/sweep_one.zig) and grades each against the in-process openjpeg
# oracle. Aggregates the per-fixture records into:
#   conformance/sweep.ndjson  — self-describing NDJSON (one record per fixture)
#   conformance/SCORECARD.md  — human/agent-readable scorecard + gap ranking
#
# The decoder is integer-only and the oracle is fixed, so the result is
# DETERMINISTIC and machine-independent: committing these artifacts turns the
# sweep into a regression net — a `jj diff` after re-running surfaces any
# PASS->FAIL drift loudly.
#
# NEVER use `set -e` here — a fixture the decoder rejects exits non-zero by
# design and `set -e` would abort the whole sweep. `set -u` alone is fine.
set -u

# Re-exec inside the Nix devShell if we're not already in it (the devShell
# provides $OPENJPEG_DATA, the openjpeg headers/libs, gtimeout and jq).
if [ -z "${OPENJPEG_DATA:-}" ]; then
	exec nix develop -c "$0" "$@"
fi

root="$(cd "$(dirname "$0")" && pwd)"
cd "$root" || exit 1

conf_dir="$OPENJPEG_DATA/input/conformance"
out_dir="$root/conformance"
ndjson="$out_dir/sweep.ndjson"
scorecard="$out_dir/SCORECARD.md"
bin="$root/zig-out/bin/jp2z-sweep-one"
timeout_secs="${SWEEP_TIMEOUT:-60}"
# Portable timeout: coreutils `timeout` (flake devShell) or macOS `gtimeout`.
timeout_bin="$(command -v timeout || command -v gtimeout || echo '')"

mkdir -p "$out_dir"

echo "==> building conformance-sweep worker"
if ! MUTE_DEBUG_STATUS=1 zig build sweep-one \
		-Dopenjpeg-include="$OPENJPEG_INCLUDE" \
		-Dopenjpeg-lib="$OPENJPEG_LIB" >/dev/null 2>&1; then
	echo "    FAIL: could not build jp2z-sweep-one" >&2
	exit 1
fi
[ -x "$bin" ] || { echo "    FAIL: $bin missing after build" >&2; exit 1; }

# Collect fixtures (globbing is disabled in this environment; use find).
fixtures=()
while IFS= read -r f; do
	fixtures+=("$f")
done < <(find "$conf_dir" -maxdepth 1 -type f \
	\( -name '*.j2k' -o -name '*.jp2' -o -name '*.j2c' \) | sort)

total=${#fixtures[@]}
echo "==> sweeping $total fixtures (timeout ${timeout_secs}s each)"

# Self-describing NDJSON header (fleet convention: first line carries provenance).
tmp="$(mktemp "${TMPDIR:-/tmp}/sweep.XXXXXX")"
printf '%s\n' '{"_meta":"jp2z conformance sweep: per-fixture decodeCleanroom-vs-openjpeg classification","schema":1,"generated_by":"./sweep (tools/sweep_one.zig)","fixture_set":"openjpeg-data ISO 15444-4 conformance","deterministic":true}' >"$tmp"

i=0
for f in "${fixtures[@]}"; do
	i=$((i + 1))
	name="$(basename "$f")"
	# The worker prints its NDJSON record (and any '#' diagnostics) to stderr
	# via std.debug.print; capture both streams and pull the record line.
	if [ -n "$timeout_bin" ]; then
		out="$(SWEEP_FIXTURE="$f" MUTE_DEBUG_STATUS=1 "$timeout_bin" "$timeout_secs" "$bin" 2>&1)"
	else
		out="$(SWEEP_FIXTURE="$f" MUTE_DEBUG_STATUS=1 "$bin" 2>&1)"
	fi
	rc=$?
	rec="$(printf '%s\n' "$out" | grep -m1 '^{')"
	if [ "$rc" -eq 124 ]; then
		rec="{\"fixture\":\"$name\",\"status\":\"TIMEOUT\",\"detail\":\"${timeout_secs}s\",\"w\":null,\"h\":null,\"comps\":null,\"max_abs\":0}"
	elif [ -z "$rec" ]; then
		# Non-zero exit with no record => panic / abort => CRASH.
		rec="{\"fixture\":\"$name\",\"status\":\"CRASH\",\"detail\":\"rc=$rc\",\"w\":null,\"h\":null,\"comps\":null,\"max_abs\":0}"
	fi
	printf '%s\n' "$rec" >>"$tmp"
	# Live progress to stderr (status only, keep it terse).
	st="$(printf '%s' "$rec" | jq -r '.status')"
	printf '\r    [%2d/%2d] %-14s %s\033[K' "$i" "$total" "$name" "$st" >&2
done
printf '\n' >&2

mv -f "$tmp" "$ndjson"

# ── Scorecard ────────────────────────────────────────────────────────────
records() { jq -c 'select(._meta | not)' "$ndjson"; }

count() { records | jq -r '.status' | grep -cx "$1" || true; }
n_pass=$(count PASS); n_near=$(count NEAR); n_fail=$(count FAIL)
n_err=$(count ERROR); n_io=$(count IO_ERROR); n_crash=$(count CRASH); n_to=$(count TIMEOUT)
n_skip=$(records | jq -r 'select(.status=="DECODED") | .detail' | grep -c '^skip:' || true)

{
	cat <<'FRONT'
---
purpose: jp2z conformance sweep scorecard — pure-Zig decode vs openjpeg oracle over the ISO 15444-4 fixture set
audience: agent
generated_from: ./sweep
---

# jp2z conformance scorecard
FRONT
	echo
	echo "Generated by \`./sweep\`. Regenerate after any decode change. The decoder is"
	echo "integer-only and the oracle is fixed, so this file is **deterministic and"
	echo "machine-independent** — a \`jj diff\` after re-running is the regression net."
	echo
	echo "## Summary ($total fixtures)"
	echo
	echo "| status | count | meaning |"
	echo "|--------|------:|---------|"
	echo "| PASS | $n_pass | byte-exact vs oracle |"
	echo "| NEAR | $n_near | max_abs ≤ 1 (lossy 9/7 integer tolerance) |"
	echo "| FAIL | $n_fail | decoded but diverges (max_abs > 1) |"
	echo "| skip:* | $n_skip | decoded; oracle not directly comparable (sub-sampled/signed/dim) |"
	echo "| ERROR | $n_err | decodeCleanroom returned an error (unsupported profile) |"
	echo "| IO_ERROR | $n_io | could not read the fixture |"
	echo "| CRASH | $n_crash | panic / non-zero exit (no record) |"
	echo "| TIMEOUT | $n_to | exceeded ${timeout_secs}s |"
	echo
	echo "## Decode gaps, ranked by severity (FAIL, max_abs desc)"
	echo
	echo "These are the highest-leverage Phase-2 targets: fixtures that decode but"
	echo "diverge from the oracle. Largest divergence first."
	echo
	echo "| fixture | w×h×comps | max_abs |"
	echo "|---------|-----------|--------:|"
	records | jq -r 'select(.status=="FAIL") | [.max_abs, .fixture, .w, .h, .comps] | @tsv' \
		| sort -rn -k1,1 \
		| awk -F'\t' '{printf "| %s | %s×%s×%s | %s |\n", $2, $3, $4, $5, $1}'
	echo
	echo "## Unsupported profiles (ERROR / CRASH / TIMEOUT)"
	echo
	echo "| fixture | status | detail |"
	echo "|---------|--------|--------|"
	records | jq -r 'select(.status=="ERROR" or .status=="CRASH" or .status=="TIMEOUT" or .status=="IO_ERROR") | [.fixture, .status, .detail] | @tsv' \
		| sort \
		| awk -F'\t' '{printf "| %s | %s | %s |\n", $1, $2, $3}'
	echo
	echo "## Per-fixture detail (all $total, by status then name)"
	echo
	echo "| fixture | status | detail | w | h | comps | max_abs |"
	echo "|---------|--------|--------|--:|--:|------:|--------:|"
	records | jq -r '[.status, .fixture, (.detail // ""), (.w // ""), (.h // ""), (.comps // ""), .max_abs] | @tsv' \
		| sort -k1,1 -k2,2 \
		| awk -F'\t' '{printf "| %s | %s | %s | %s | %s | %s | %s |\n", $2, $1, $3, $4, $5, $6, $7}'
} >"$scorecard"

# ── Terminal summary ─────────────────────────────────────────────────────
echo
echo "==> scorecard written:"
echo "    $ndjson"
echo "    $scorecard"
echo
printf 'PASS %d   NEAR %d   FAIL %d   skip %d   ERROR %d   CRASH %d   TIMEOUT %d   (of %d)\n' \
	"$n_pass" "$n_near" "$n_fail" "$n_skip" "$n_err" "$n_crash" "$n_to" "$total"
