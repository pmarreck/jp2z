+/* --- jp2z cblk dump --------------------------------------------------
+ * When JP2Z_DUMP_T1 names a writable file path, every successful cblk
+ * decode appends a fixed-format binary record. The dump is env-gated;
+ * with the var unset the cost is one getenv() probe on the first call.
+ * Run with OPJ_NUM_THREADS=1 for a deterministic ordering.
+ */
+static FILE*        jp2z_dump_fp = NULL;
+static opj_mutex_t* jp2z_dump_mutex = NULL;
+static int          jp2z_dump_initialised = 0;
 
+static void jp2z_dump_maybe_init(void)
+{
+    const char* path;
+    if (jp2z_dump_initialised) {
+        return;
+    }
+    jp2z_dump_initialised = 1;
+    path = getenv("JP2Z_DUMP_T1");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+    jp2z_dump_mutex = opj_mutex_create();
+    if (jp2z_dump_mutex == NULL) {
+        return;
+    }
+    jp2z_dump_fp = fopen(path, "ab");
+    /* Leak fp on process exit — kernel flushes / closes. */
+}
 
+static void jp2z_dump_cblk(opj_t1_t* t1,
+                           opj_tcd_cblk_dec_t* cblk,
+                           OPJ_UINT32 orient,
+                           OPJ_UINT32 tile_idx,
+                           OPJ_UINT32 comp_idx,
+                           OPJ_UINT32 resno,
+                           OPJ_UINT32 precinct_idx)
+{
+    OPJ_UINT32 magic = 0x4B4C4243u; /* 'CBLK' little-endian */
+    OPJ_INT32 x0 = cblk->x0;
+    OPJ_INT32 y0 = cblk->y0;
+    OPJ_INT32 x1 = cblk->x1;
+    OPJ_INT32 y1 = cblk->y1;
+    OPJ_UINT32 w = (OPJ_UINT32)(x1 - x0);
+    OPJ_UINT32 h = (OPJ_UINT32)(y1 - y0);
+    OPJ_UINT32 numbps = cblk->numbps;
+    OPJ_UINT32 data_len = w * h * (OPJ_UINT32)sizeof(OPJ_INT32);
+    OPJ_INT32* src = t1->data;
+    jp2z_dump_maybe_init();
+    /* jp2z tier-2 per-code-block oracle: with JP2Z_DUMP_T2 set, print the
+     * total passes and bytes T2 handed this block so the jp2z packet-header
+     * walker's per-block accounting can be diffed against openjpeg's. */
+    if (getenv("JP2Z_DUMP_T2") != NULL) {
+        OPJ_UINT32 passes = 0, bytes = 0, i;
+        for (i = 0; i < cblk->real_num_segs; i++) {
+            passes += cblk->segs[i].real_num_passes;
+        }
+        for (i = 0; i < cblk->numchunks; i++) {
+            bytes += cblk->chunks[i].len;
+        }
+        fprintf(stderr, "jp2zCB t=%u c=%u r=%u b=%u p=%u x0=%d y0=%d passes=%u bytes=%u\n",
+                tile_idx, comp_idx, resno, orient, precinct_idx, x0, y0, passes, bytes);
+    }
+    if (jp2z_dump_fp == NULL) {
+        return;
+    }
+    opj_mutex_lock(jp2z_dump_mutex);
+    fwrite(&magic,        4, 1, jp2z_dump_fp);
+    fwrite(&tile_idx,     4, 1, jp2z_dump_fp);
+    fwrite(&comp_idx,     4, 1, jp2z_dump_fp);
+    fwrite(&resno,        4, 1, jp2z_dump_fp);
+    fwrite(&orient,       4, 1, jp2z_dump_fp); /* band orientation = bandno */
+    fwrite(&precinct_idx, 4, 1, jp2z_dump_fp);
+    fwrite(&x0,           4, 1, jp2z_dump_fp);
+    fwrite(&y0,           4, 1, jp2z_dump_fp);
+    fwrite(&x1,           4, 1, jp2z_dump_fp);
+    fwrite(&y1,           4, 1, jp2z_dump_fp);
+    fwrite(&numbps,       4, 1, jp2z_dump_fp);
+    fwrite(&data_len,     4, 1, jp2z_dump_fp);
+    if (data_len > 0 && src != NULL) {
+        fwrite(src, 1, data_len, jp2z_dump_fp);
+    }
+    fflush(jp2z_dump_fp);
+    opj_mutex_unlock(jp2z_dump_mutex);
+}
+/* --- end jp2z cblk dump --------------------------------------------- */
