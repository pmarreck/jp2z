#!/usr/bin/env bash
# jp2z CLI test: the `validate` verb. Driven by build.zig (test step) with
#   validate_cli <path-to-jp2z> <fixtures-dir>
# Exit code = number of failed checks. No `set -e`: non-zero exits from the
# command under test are the behaviour being asserted.
set -u
cli="$1"; fx="$2"
fails=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }
check_rc() { # desc expected actual
	if [ "$2" = "$3" ]; then pass "$1 (rc=$3)"; else fail "$1 (expected rc=$2, got rc=$3)"; fi
}
tmp="${TMPDIR:-/tmp}/jp2z-validate-cli.$$"
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT
mono="$fx/c1_mono.j2c"

# 1. clean fixture: strict by default, verdict on stderr, exit 0
err=$("$cli" validate "$mono" 2>&1 >/dev/null); rc=$?
check_rc "clean strict verdict exits 0" 0 "$rc"
case "$err" in *"overall: "*) pass "verdict line on stderr";; *) fail "verdict line on stderr (got: $err)";; esac

# 2. --json puts a JSON document on stdout, nothing on stderr
out=$("$cli" validate --json "$mono" 2>"$tmp/err"); rc=$?
check_rc "--json exits 0" 0 "$rc"
case "$out" in '{"overall":'*'"findings":'*) pass "--json document shape";; *) fail "--json document shape (got: ${out:0:80})";; esac
[ ! -s "$tmp/err" ] && pass "--json keeps stderr empty" || fail "--json keeps stderr empty (stderr: $(cat "$tmp/err"))"

# 3. stdin via "-"
"$cli" validate - < "$mono" >/dev/null 2>&1; rc=$?
check_rc "validate - reads stdin" 0 "$rc"

# 4. a byte flipped mid-stream: strict FAILs (1), lenient WARNs (2)
cp "$mono" "$tmp/corrupt.j2c"
size=$(wc -c < "$mono"); mid=$((size / 2))
printf '\377' | dd of="$tmp/corrupt.j2c" bs=1 seek="$mid" conv=notrunc status=none
err=$("$cli" validate --strict "$tmp/corrupt.j2c" 2>&1 >/dev/null); rc=$?
check_rc "corrupted strict exits 1" 1 "$rc"
case "$err" in *"overall: fail"*) pass "corrupted strict says fail";; *) fail "corrupted strict says fail (got: $err)";; esac
"$cli" validate --lenient "$tmp/corrupt.j2c" >/dev/null 2>&1; rc=$?
check_rc "corrupted lenient exits 2 (warn)" 2 "$rc"

# 5. later flag wins: --lenient --strict is strict
"$cli" validate --lenient --strict "$tmp/corrupt.j2c" >/dev/null 2>&1; rc=$?
check_rc "later flag wins (--lenient --strict)" 1 "$rc"

# 6. a path with spaces
mkdir -p "$tmp/dir with space"; cp "$mono" "$tmp/dir with space/a b.j2c"
"$cli" validate "$tmp/dir with space/a b.j2c" >/dev/null 2>&1; rc=$?
check_rc "path with spaces" 0 "$rc"

# 7. missing file → I/O error exit 74; no path → usage exit 64; neither is 1 or 2
"$cli" validate "$tmp/does-not-exist.j2c" >/dev/null 2>&1; rc=$?
check_rc "missing file exits 74" 74 "$rc"
"$cli" validate >/dev/null 2>&1; rc=$?
check_rc "no path exits 64 (usage)" 64 "$rc"

# 8. help mentions the verb
"$cli" --help 2>/dev/null | grep -q 'validate' && pass "--help lists validate" || fail "--help lists validate"

# 9. --about: one line with the name, version, platform and architecture
about=$("$cli" --about 2>/dev/null); rc=$?
check_rc "--about exits 0" 0 "$rc"
[ "$(printf '%s\n' "$about" | wc -l)" = "1" ] && pass "--about is one line" || fail "--about is one line (got: $about)"
case "$about" in jp2z*[0-9]*linux*|jp2z*[0-9]*macos*|jp2z*[0-9]*windows*) pass "--about names version and platform";; *) fail "--about names version and platform (got: $about)";; esac

printf '%s\n' "validate_cli: $fails failure(s)"
exit "$fails"
